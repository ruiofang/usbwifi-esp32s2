CONFIG_IDF_TARGET_ESP32S2=y
CONFIG_ESPTOOLPY_FLASH_MODE_QIO=y
CONFIG_ESPTOOLPY_FLASH_SIZE_4MB=y
CONFIG_ESPTOOLPY_FLASH_FREQ_80M=y

CONFIG_USB_DEVICE_ENABLE=y
CONFIG_USB_CDC_ENABLE=y
CONFIG_USB_CDC_ECM_ENABLE=y
CONFIG_USB_CDC_ACM_ENABLE=y
CONFIG_USB_CDC_ACM_SUPPORT_LINE_CODING=y

CONFIG_ESP_CONSOLE_USB_CDC=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_ESP_SYSTEM_PANIC_SILENT_REBOOT=y

CONFIG_WIFI_ENABLED=y
CONFIG_WIFI_STA_ENABLED=y
CONFIG_WIFI_AP_ENABLED=y
CONFIG_WIFI_SOFTAP_SUPPORT_MAX_STA_CONN=1

CONFIG_LWIP_IPV4=y
CONFIG_LWIP_DHCP_SERVER=y
CONFIG_LWIP_DHCP_CLIENT=y
CONFIG_LWIP_TCP=y
CONFIG_LWIP_UDP=y

CONFIG_ESP_TASK_WDT_ENABLE=n
